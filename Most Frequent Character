class Solution {
    public static char getMaxOccuringChar(String s) {
        // code here
        int n = s.length();
        int maxFreq = -1;
        char ans = s.charAt(0);
        for(int i=0;i<n;i++){
            int Freq =1;
            char ch = s.charAt(i);
            for(int j=i+1;j<n;j++){
                if(s.charAt(j)==ch) Freq++;
            }
            if(Freq>maxFreq){
                maxFreq = Freq;
                ans =ch;
            }else if(Freq == maxFreq && ch<ans){
                ans=ch;
            }
        }
        return ans;
    }
}
